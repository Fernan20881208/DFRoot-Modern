<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DirtyFrag" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:statusBarColor">@color/df_background</item>
        <item name="android:navigationBarColor">@color/df_background</item>
        <item name="android:windowBackground">@color/df_background</item>
        <item name="android:colorPrimary">@color/df_surface</item>
        <item name="android:colorAccent">@color/df_primary</item>
        <item name="android:actionBarTheme">@style/Theme.DirtyFrag.ActionBar</item>
    </style>
    <style name="Theme.DirtyFrag.ActionBar" parent="android:style/ThemeOverlay.Material.ActionBar">
        <item name="android:colorControlNormal">@color/df_on_surface</item>
    </style>
</resources>
